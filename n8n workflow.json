    {
      "parameters": {
        "jsCode": "// 1. Get all articles from the Merge node\nlet allArticles = $input.all();\n\n// 2. Define the assets and their search keywords (Regex word boundaries prevent \"ETH\" from matching \"Tether\")\nconst assetKeywords = {\n    \"BTC\": [\"BTC\", \"Bitcoin\"],\n    \"ETH\": [\"ETH\", \"Ethereum\"],\n    \"SOL\": [\"SOL\", \"Solana\"],\n    \"XRP\": [\"XRP\", \"Ripple\"],\n    \"BNB\": [\"BNB\", \"Binance\"],\n    \"LINK\": [\"LINK\", \"Chainlink\"]\n};\n\n// 3. Helper function to format the article text cleanly\nfunction formatArticle(item) {\n    let title = item.json.title || \"No Title\";\n    let rawDesc = item.json.contentSnippet || item.json.description || \"\";\n    let cleanDesc = rawDesc.replace(/<[^>]*>?/gm, '').substring(0, 150).trim();\n    return `Headline: ${title} - Context: ${cleanDesc}...`;\n}\n\n// 4. Create the global macro fallback (Top 3 general news)\nlet fallbackNews = allArticles.slice(0, 3).map(formatArticle).join(\" | \");\n\n// 5. Build the final output array\nlet output = [];\n\nfor (const [ticker, keywords] of Object.entries(assetKeywords)) {\n    // Filter articles that mention the ticker or full name in the title or description\n    let specificArticles = allArticles.filter(item => {\n        let contentToSearch = (item.json.title + \" \" + (item.json.description || \"\")).toLowerCase();\n        return keywords.some(kw => {\n            let regex = new RegExp('\\\\b' + kw.toLowerCase() + '\\\\b', 'i');\n            return regex.test(contentToSearch);\n        });\n    });\n\n    // Grab up to top 3 specific articles, or use fallback if none exist\n    let finalNewsString = \"\";\n    if (specificArticles.length > 0) {\n        finalNewsString = specificArticles.slice(0, 3).map(formatArticle).join(\" | \");\n    } else {\n        finalNewsString = `No specific news. Macro context: ${fallbackNews}`;\n    }\n\n    // Push to the loop\n    output.push({\n        json: {\n            asset: ticker,\n            news: finalNewsString\n        }\n    });\n}\n\nreturn output;"
      },
