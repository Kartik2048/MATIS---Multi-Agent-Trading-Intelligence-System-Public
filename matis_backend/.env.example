# ============================================================
# MATIS v3 — Environment Configuration Template
# Copy this file to .env and insert your real credentials.
# ============================================================

# [MANDATORY] NVIDIA NIM API Key
# Powers the Sentinel, Strategist, and Critic AI agents using meta/llama-3.3-70b-instruct.
# Generate your key at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# [OPTIONAL] Telegram Alerts (Only needed if using the n8n workflow notification node)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
