# ============================================================
# MATIS v3 — Environment Configuration Template
# Copy this file to .env and insert your real credentials.
# ============================================================

# [MANDATORY] NVIDIA NIM API Key & Model
# Powers Sentinel, Strategist, and Critic AI agents.
# Generate your key at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# [OPTIONAL] Autonomous Multi-Asset Evaluation Loop
# Evaluates all supported assets concurrently using an asyncio semaphore.
AUTO_TRADING=true
AUTO_EVALUATE_INTERVAL_SECONDS=300
MAX_CONCURRENT_EVALUATIONS=2

# [OPTIONAL] Telegram Alerts (Triggered directly on executed BUY / SELL orders)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

